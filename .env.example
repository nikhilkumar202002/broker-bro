# Broker Bro backend API
VITE_API_BASE_URL=https://brokerbroapi.realtybrokerbro.com/api

# Optional Nominatim server or production proxy
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional comma-separated ISO 3166-1 alpha-2 search restriction, for example: in
VITE_NOMINATIM_COUNTRYCODES=

# Optional initial map center. Central India is used when these are omitted.
VITE_DEFAULT_MAP_LATITUDE=
VITE_DEFAULT_MAP_LONGITUDE=

